# Copy to .env. Never commit the real file.

# JIRA
JIRA_SERVER=https://your-company.atlassian.net
JIRA_USERNAME=you@company.com
JIRA_API_KEY=

# Release(s) to analyse. Comma-separated for multiple.
CURRENT_RELEASE=R1-25
DEFAULT_RELEASES=R1-25

# Local store
DB_PATH=defect_intelligence.db

# Optional: LLM classification of defect text. Without it the tool falls
# back to the classical ML path and still works.
OPENAI_API_KEY=

# ── Jira site specifics ───────────────────────────────────────────────────
# Custom field ids are assigned per Jira site, so there are no defaults.
# Find yours under Settings -> Issues -> Custom fields.
# Format: name=customfield_NNNNN, comma separated.
CUSTOM_FIELDS=

# Bare id of the field used to order by severity, e.g. 99999. Optional.
SEVERITY_FIELD=

# Issue types that count as a defect, comma separated.
DEFECT_ISSUE_TYPES=Bug

# Subset of the above treated as critical, highest priority first.
CRITICAL_ISSUE_TYPES=

# CURRENT_RELEASE is set at the top of this file. It was declared twice, and
# python-dotenv keeps the last occurrence, so the blank one here quietly
# overrode the example value above.
